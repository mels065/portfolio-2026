{
"compilerOptions": {
  "target": "ES2020",
  "module": "ESNext",
  "lib": ["ES2020", "DOM"],
  "jsx": "react-jsx",
  "allowJs": true,
  "checkJs": false,
  "skipLibCheck": true,
  "esModuleInterop": true,
  "forceConsistentCasingInFileNames": true,
  "resolveJsonModule": true,
  "isolatedModules": true,
  "noEmit": true,
  "strict": false,
  "paths": {},
  "typeRoots": ["./types", "./node_modules/@types"]
  },
  "include": ["**/*"],
  "exclude": ["node_modules", "dist"]
}