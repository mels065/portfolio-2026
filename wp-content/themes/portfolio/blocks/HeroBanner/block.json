{
  "apiVersion": 2,
  "name": "portfolio/hero",
  "title": "Hero Banner",
  "category": "common",
  "keywords": ["hero", "banner"],
  "icon": "format-image",
  "description": "Hero banner block.",
  "supports": {
    "html": false
  },
  "editorScript": "file:./build/index.js",
  "editorStyle": "file:./build/index.css",
  "style": "file:./build/style-index.css",
  "attributes": {
    "badge": {
      "type": "string",
      "source": "text",
      "selector": "p",
      "default": "Badge"
    },
    "title": {
      "type": "string",
      "source": "text",
      "selector": "h1",
      "default": "Hello"
    },
    "subtitle": {
      "type": "string",
      "source": "text",
      "selector": "p",
      "default": "Subtitle"
    },
    "primaryButton": {
      "type": "object",
      "default": {
        "label": "Primary Label",
        "href": "#",
        "target": "_self"
      }
    },
    "secondaryButton": {
      "type": "object",
      "default": {
        "label": "Secondary Label",
        "href": "#",
        "target": "_self"
      }
    }
  }
}
